<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="AUTOMATION">
    <test name="SQL-Regression">
        <classes>
            <class name="testCases.smokeTestCases">
                <methods>
                    <include name="loginLogout"/>
                    <include name="connectDatabase"/>
                    <include name="sqlQueryValidation"/>
                    <include name="activeLicensedUsers"/>
                    <include name="usedOfferings"/>
                    <include name="seededRoles"/>
                    <include name="customRoles"/>
                    <include name="licenseReports"/>
                </methods>
            </class>
            <class name="testCases.NewConnection">
                <methods>
                    <include name="createNewConnection"/>
                    <include name="newConnectionDefaults"/>
                    <include name="newConnectionInvalidDetails"/>
                </methods>
            </class>
        </classes>
    </test>
</suite>
